# Backend: copy these into .env in the repo root (backend/main.py loads it from there; never commit .env)
GOOGLE_MAPS_API_KEY=            # Routes API key (server side)
GEMINI_API_KEY=                 # Google AI Studio key
GEMINI_MODEL=                   # optional; leave empty to use the backend default
CAR_FREE_MAX_MIN=45
HART_FARE=2.00                  # verify the current fare

# frontend/.env
VITE_GOOGLE_MAPS_KEY=           # Maps JavaScript API key (restrict to localhost)
VITE_API_URL=http://localhost:8000
